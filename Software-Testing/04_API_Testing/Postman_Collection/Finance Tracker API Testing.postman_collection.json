    {
      "name": "04_Reports_API",
      "item": [
        {
          "name": "API-13: Generate monthly report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Monthly report generated\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Report contains required fields\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response).to.have.property(\"month\");\r\n    pm.expect(response).to.have.property(\"income\");\r\n    pm.expect(response).to.have.property(\"expenses\");\r\n    pm.expect(response).to.have.property(\"balance\");\r\n    pm.expect(response).to.have.property(\"byCategory\");\r\n    pm.expect(response).to.have.property(\"transactions\");\r\n});\r\n\r\npm.test(\"Balance calculation is correct\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.balance).to.eql(\r\n        response.income - response.expenses\r\n    );\r\n});"
                ]
              }
            }
          ],
